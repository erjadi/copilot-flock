{
  "name": "copilot-flock",
  "version": "3.3.0",
  "license": "Apache-2.0",
  "description": "Zero-dependency cross-machine multi-flock platform for GitHub Copilot Desktop & CLI over Azure SignalR Service (copilot-flock)",
  "type": "module",
  "main": "flock.mjs",
  "bin": {
    "copilot-flock": "./flock.mjs",
    "copilot-bridge": "./bridge.mjs"
  },
  "scripts": {
    "start": "node bootstrap-server.mjs",
    "daemon": "node --experimental-sqlite flock.mjs daemon",
    "install-flock": "node --experimental-sqlite flock.mjs install",
    "install-bridge": "node --experimental-sqlite flock.mjs install",
    "status": "node --experimental-sqlite flock.mjs status",
    "machines": "node --experimental-sqlite flock.mjs machines",
    "members": "node --experimental-sqlite flock.mjs members",
    "specs": "node --experimental-sqlite flock.mjs specs",
    "sessions": "node --experimental-sqlite flock.mjs sessions",
    "viewer": "node viewer/viewer-server.mjs",
    "self-test": "node --experimental-sqlite flock.mjs self-test",
    "test": "node --experimental-sqlite --test --test-concurrency=1 test/flock.test.mjs test/bridge.test.mjs test/setup.test.mjs test/contracts.test.mjs test/rpc-security.test.mjs test/zero-broker-roster.test.mjs test/zero-broker-lifecycle.test.mjs",
    "test:zero-broker": "node --experimental-sqlite --test --test-concurrency=1 test/zero-broker-roster.test.mjs test/zero-broker-lifecycle.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "private": true
}
